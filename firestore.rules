rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // A user's own account record.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // An advisor's application/profile. Public read once approved (needed by
    // the advisor list/profile screens); only the owner can write, and only
    // the owner can move their own status (owner review happens by hand in
    // the Firebase console for now, not through the app).
    match /advisors/{uid} {
      allow read: if resource.data.status == 'approved' ||
        (request.auth != null && request.auth.uid == uid);
      allow write: if request.auth != null && request.auth.uid == uid;

      match /places/{placeId} {
        allow read: if get(/databases/$(database)/documents/advisors/$(uid)).data.status == 'approved' ||
          (request.auth != null && request.auth.uid == uid);
        allow write: if request.auth != null && request.auth.uid == uid;
      }
    }

    match /requests/{requestId} {
      allow read, update: if request.auth != null &&
        (request.auth.uid == resource.data.travellerId || request.auth.uid == resource.data.advisorId);
      allow create: if request.auth != null && request.auth.uid == request.resource.data.travellerId;
    }
  }
}
